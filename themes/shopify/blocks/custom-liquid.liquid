{%- doc -%}
  Custom Liquid block: add app snippets or other Liquid code. Usable in any section that accepts theme blocks.
{%- enddoc -%}
<div class="custom-liquid" {{ block.shopify_attributes }}>
  {{ block.settings.custom_liquid }}
</div>

{% stylesheet %}
  .custom-liquid:empty {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid code",
      "info": "Add app snippets or other Liquid code to create advanced customizations."
    }
  ],
  "presets": [{ "name": "Custom Liquid" }]
}
{% endschema %}
