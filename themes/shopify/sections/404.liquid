{%- comment -%} Page not found: a clear message, a search field and ways back. {%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'store.not_found.title' | t
  endif
-%}
<div class="store-section notfound-section color-{{ section.settings.color_scheme }} full-width">
  <div class="page page--center store-page notfound">
    <p class="eyebrow">{{ 'store.not_found.eyebrow' | t }}</p>
    <h1 class="page__title" tabindex="-1">
      <span class="ln"><span class="ln__in">{{ heading | escape }}</span></span>
    </h1>
    <p class="page__lead">{{ 'store.not_found.subtext' | t }}</p>

    {%- if section.settings.show_search -%}
      <form class="store-search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="NotFoundSearch">{{ 'store.not_found.search_label' | t }}</label>
        <input
          type="search"
          id="NotFoundSearch"
          name="q"
          placeholder="{{ 'store.not_found.search_placeholder' | t }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button class="pill" type="submit">{{ 'store.not_found.search_submit' | t }}</button>
      </form>
    {%- endif -%}

    <div class="notfound__links">
      <a class="btn btn--solid" href="{{ routes.all_products_collection_url }}">{{ 'store.not_found.shop' | t }}</a>
      <a class="link" href="{{ routes.root_url }}">{{ 'store.not_found.home' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page not found",
  "class": "section-404",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the default message."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search field"
    }
  ]
}
{% endschema %}
