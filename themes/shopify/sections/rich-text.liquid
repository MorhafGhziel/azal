<section class="block-sec rich color-{{ section.settings.color_scheme }} align-{{ section.settings.align }}" id="rich-{{ section.id }}">
  <div class="rich__in">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}
          <h2 class="rich__title h-{{ block.settings.size }}" {{ block.shopify_attributes }}><span class="ln"><span class="ln__in">{{ block.settings.heading | escape }}</span></span></h2>
        {%- when 'text' -%}
          <div class="rich__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <a class="pill rich__btn" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "class": "section-rich",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:sections.common.scheme.label" },
    { "type": "select", "id": "align", "default": "center", "label": "t:sections.common.align.label", "options": [
      { "value": "start", "label": "t:sections.common.align.options__1.label" },
      { "value": "center", "label": "t:sections.common.align.options__2.label" }
    ] }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "t:sections.rich-text.blocks.eyebrow.name", "limit": 1, "settings": [
      { "type": "text", "id": "text", "default": "The house", "label": "t:sections.rich-text.blocks.eyebrow.settings.text.label" } ] },
    { "type": "heading", "name": "t:sections.rich-text.blocks.heading.name", "settings": [
      { "type": "text", "id": "heading", "default": "Made slowly, worn for hours.", "label": "t:sections.rich-text.blocks.heading.settings.heading.label" },
      { "type": "select", "id": "size", "default": "l", "label": "t:sections.rich-text.blocks.heading.settings.size.label", "options": [
        { "value": "m", "label": "M" }, { "value": "l", "label": "L" }, { "value": "xl", "label": "XL" } ] } ] },
    { "type": "text", "name": "t:sections.rich-text.blocks.text.name", "settings": [
      { "type": "richtext", "id": "text", "default": "<p>Tell the story of your house: where the ingredients come from, who makes them, and why it matters.</p>", "label": "t:sections.rich-text.blocks.text.settings.text.label" } ] },
    { "type": "button", "name": "t:sections.rich-text.blocks.button.name", "settings": [
      { "type": "text", "id": "label", "default": "Discover", "label": "t:sections.rich-text.blocks.button.settings.label.label" },
      { "type": "url", "id": "link", "label": "t:sections.rich-text.blocks.button.settings.link.label" } ] }
  ],
  "presets": [ { "name": "t:sections.rich-text.presets.name", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" } ] } ]
}
{% endschema %}
