<div class="page">
  <header class="page__head">
    <h1 class="page__title" tabindex="-1"><span class="ln"><span class="ln__in">{{ blog.title | escape }}</span></span></h1>
  </header>
  {%- paginate blog.articles by 9 -%}
    <ul class="grid journal" role="list">
      {%- for article in blog.articles -%}
        <li class="card card--article">
          <a class="card__img" href="{{ article.url }}" style="--bg: {{ settings.color_card_bg }};" tabindex="-1" aria-hidden="true">
            {%- if article.image -%}
              {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 900px) 33vw, 100vw', alt: '' }}
            {%- else -%}
              {%- render 'scene-picture', d: 'origins-land_d.webp' -%}
            {%- endif -%}
          </a>
          <div class="card__info">
            <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="card__name"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            <p class="card__char">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "t:sections.main-blog.name", "settings": [] }
{% endschema %}
