<div class="page page--form">
  <header class="page__head"><h1 class="page__title" tabindex="-1">{{ 'customer.reset.title' | t }}</h1><p class="page__lead">{{ 'customer.reset.subtext' | t }}</p></header>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<p class="field__err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="field"><span class="field__label">{{ 'customer.fields.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="field"><span class="field__label">{{ 'customer.fields.password_confirm' | t }}</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button class="btn btn--solid" type="submit">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "t:sections.customers.reset", "settings": [] }
{% endschema %}
