<div class="page">
  <header class="page__head">
    <h1 class="page__title" tabindex="-1"><span class="ln"><span class="ln__in">{{ 'search.title' | t }}</span></span></h1>
  </header>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <input type="hidden" name="type" value="product,page,article">
    <label class="visually-hidden" for="SearchInput">{{ 'search.label' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
    <button class="pill" type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    <p class="page__lead">{%- assign terms = search.terms | escape -%}{{ 'search.results' | t: count: search.results_count, terms: terms }}</p>
    {%- paginate search.results by 12 -%}
      {%- if search.results_count > 0 -%}
        <ul class="grid" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item, index: forloop.index0, heading_tag: 'h2' -%}
            {%- else -%}
              <li class="card card--text">
                <div class="card__info">
                  <p class="eyebrow">{{ item.object_type | capitalize }}</p>
                  <h2 class="card__name"><a href="{{ item.url }}">{{ item.title | escape }}</a></h2>
                  <p class="card__char">{{ item.content | strip_html | truncatewords: 24 }}</p>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "t:sections.main-search.name", "settings": [] }
{% endschema %}
