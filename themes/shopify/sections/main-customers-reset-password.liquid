{%- comment -%} Choose a new password from the reset link. {%- endcomment -%}
<div class="store-section account-section color-{{ section.settings.color_scheme }} full-width">
  <div class="page page--form store-page account-page">
    <header class="page__head">
      <h1 class="page__title" tabindex="-1">
        <span class="ln"><span class="ln__in">{{ 'store.customer.reset.title' | t }}</span></span>
      </h1>
      <p class="page__lead">{{ 'store.customer.reset.subtext' | t }}</p>
    </header>
    {%- form 'reset_customer_password' -%}
      {%- render 'store-form-errors', form: form, id: 'ResetErrors' -%}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'store.customer.fields.password' | t }}</label>
        <input
          type="password"
          id="ResetPassword"
          name="customer[password]"
          autocomplete="new-password"
          required
          {% if form.errors contains 'password' %}
            aria-invalid="true"
            aria-describedby="ResetErrors"
          {% endif %}
        >
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'store.customer.fields.password_confirm' | t }}</label>
        <input
          type="password"
          id="ResetPasswordConfirm"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
          {% if form.errors contains 'password_confirmation' %}
            aria-invalid="true"
            aria-describedby="ResetErrors"
          {% endif %}
        >
      </div>
      <button class="btn btn--solid btn--full" type="submit">{{ 'store.customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "class": "section-customers-reset",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
