<div class="page">
  <header class="page__head">
    <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
    <h1 class="page__title" tabindex="-1">{{ customer.first_name | default: customer.name | escape }}</h1>
    <p class="page__lead"><a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a></p>
  </header>
  <div class="acct">
    <section>
      <h2 class="eyebrow">{{ 'customer.orders.title' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="acct__table">
            <thead><tr><th scope="col">{{ 'customer.orders.order' | t }}</th><th scope="col">{{ 'customer.orders.date' | t }}</th><th scope="col">{{ 'customer.orders.fulfillment' | t }}</th><th scope="col">{{ 'customer.orders.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_net_amount | money_with_currency }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p class="muted">{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    </section>
    <aside>
      <h2 class="eyebrow">{{ 'customer.account.details' | t }}</h2>
      {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
      <p><a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t: count: customer.addresses_count }}</a></p>
    </aside>
  </div>
</div>

{% schema %}
{ "name": "t:sections.customers.account", "settings": [] }
{% endschema %}
