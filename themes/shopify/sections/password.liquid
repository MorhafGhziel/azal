{%- comment -%}
  Password page: logo or shop name, the password message, a newsletter signup and the storefront password form.
{%- endcomment -%}
{%- form 'storefront_password' -%}
  {%- if form.errors -%}{%- assign password_open = true -%}{%- endif -%}
{%- endform -%}
<div class="store-section pw color-{{ section.settings.color_scheme }} full-width">
  {%- if section.settings.image != blank -%}
    <div class="pw__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'pw__img', alt: ''
      }}
      <span class="pw__shade" style="--pw-shade: {{ section.settings.overlay | divided_by: 100.0 }};"></span>
    </div>
  {%- endif -%}

  <div class="pw__card">
    <p class="pw__brand">
      {%- if settings.logo != blank -%}
        {%- assign logo_style = settings.logo_width | times: 3 | prepend: 'max-width: ' | append: 'px' -%}
        {{
          settings.logo
          | image_url: width: 480
          | image_tag: class: 'pw__logo', alt: shop.name, widths: '120, 240, 360, 480', sizes: '240px', style: logo_style
        }}
      {%- else -%}
        <span class="pw__shop">{{ shop.name | escape }}</span>
      {%- endif -%}
    </p>

    <h1 class="pw__title">
      <span class="ln"><span class="ln__in">{{ section.settings.heading | escape }}</span></span>
    </h1>
    {%- if shop.password_message != blank -%}
      <p class="pw__lead">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', id: 'PasswordNewsletter', class: 'news pw__news' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password page">
        {%- if form.posted_successfully? -%}
          <p class="news__ok" role="status" tabindex="-1" autofocus>{{ 'store.password.newsletter_success' | t }}</p>
        {%- else -%}
          <p class="eyebrow pw__news-title" id="PasswordNewsletterTitle">{{ 'store.password.newsletter_title' | t }}</p>
          <div class="news__row">
            <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'store.password.newsletter_label' | t }}</label>
            <input
              id="PasswordNewsletterEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              required
              placeholder="{{ 'store.password.newsletter_label' | t }}"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="PasswordNewsletterError"
              {% endif %}
            >
            <button class="pill" type="submit">{{ 'store.password.newsletter_submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="field__err pw__err" id="PasswordNewsletterError" role="alert">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <details class="password__enter pw__enter"{% if password_open %} open{% endif %}>
      <summary class="link">{{ 'store.password.enter_toggle' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form pw__form' -%}
        <label class="visually-hidden" for="PasswordInput">{{ 'store.password.label' | t }}</label>
        <input
          type="password"
          name="password"
          id="PasswordInput"
          autocomplete="current-password"
          placeholder="{{ 'store.password.label' | t }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="PasswordError"
            autofocus
          {% endif %}
        >
        <button class="pill" type="submit">{{ 'store.password.submit' | t }}</button>
        {%- if form.errors -%}
          <p class="field__err pw__err" id="PasswordError" role="alert">{{ form.errors.messages.form }}</p>
        {%- endif -%}
      {%- endform -%}
    </details>

    <p class="pw__owner small">
      {{ 'store.password.owner_html' | t: link: '/admin' }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "class": "section-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Opening soon",
      "label": "Heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45,
      "label": "Image overlay opacity"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "default": true,
      "label": "Show newsletter signup"
    }
  ]
}
{% endschema %}
