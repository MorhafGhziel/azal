{%- comment -%}
  Product recommendations, loaded after the page through the Product Recommendations API.
  "Related" shows products Shopify finds similar; "Complementary" shows the products set up to pair with this
  one in the Shopify Search and Discovery app. The section stays hidden when there is nothing to show.
{%- endcomment -%}
{%- liquid
  assign heading_id = 'RecsTitle-' | append: section.id
  assign columns = section.settings.columns
  assign recs_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=' | append: section.settings.intent
-%}
<div
  class="recs recs--{{ section.settings.intent }} color-{{ section.settings.color_scheme }}"
  data-recommendations
  data-url="{{ recs_url }}"
  {% if section.settings.heading != blank %}
    role="region"
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="recs__in" data-recommendations-loaded>
      {%- if section.settings.heading != blank -%}
        <h2 class="recs__title eyebrow" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <ul class="grid recs__grid" role="list" style="--recs-cols: {{ columns }};">
        {%- for rec in recommendations.products -%}
          {%- render 'card-product', product: rec, index: 10, heading_tag: 'h3', show_quick_add: section.settings.show_quick_add -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-recommendations",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "default": "related",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "info": "Complementary products are set up in the Shopify Search and Discovery app."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
