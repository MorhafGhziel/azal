{%- comment -%}
  The cart drawer (settings.cart_type == 'drawer'), rendered from layout/theme.liquid with {% section 'cart-drawer' %}.
  A modal dialog: focus is trapped inside, Escape closes it and focus returns to the opener (assets/azal-cart.js).
  It slides from the inline end, so from the left in right-to-left languages.
{%- endcomment -%}
<div
  class="drawer cart-drawer"
  id="CartDrawer"
  data-drawer
  data-cart-empty="{% if cart.item_count == 0 %}true{% else %}false{% endif %}"
  hidden
>
  <div class="drawer__dim" data-close aria-hidden="true"></div>
  <div
    class="drawer__panel color-{{ section.settings.color_scheme }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    tabindex="-1"
  >
    <header class="drawer__head">
      <h2 class="drawer__title" id="CartDrawerTitle" data-cart-replace="title">
        {{- 'store.cart.title' | t }}
        <span class="drawer__count">({{ cart.item_count }})</span>
      </h2>
      <button class="drawer__x" type="button" data-close aria-label="{{ 'store.cart.close' | t }}">
        {%- render 'cart-icon', icon: 'close' -%}
      </button>
    </header>

    <p
      class="visually-hidden"
      role="status"
      aria-live="polite"
      data-cart-live
      data-msg-updated="{{ 'store.cart.updated' | t | escape }}"
      data-msg-removed="{{ 'store.cart.removed' | t | escape }}"
      data-msg-max="{{ 'store.cart.max_reached' | t: quantity: '__N__' | escape }}"
    ></p>
    <p class="field__err drawer__error" role="alert" data-cart-error></p>

    <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate></form>

    <div class="drawer__body" data-lenis-prevent data-cart-body data-cart-replace="lines">
      {%- render 'cart-lines', scope: 'drawer' -%}
    </div>

    <footer class="drawer__foot cart-drawer__foot"{% if cart.item_count == 0 %} hidden{% endif %}>
      {%- render 'cart-extras', scope: 'drawer' -%}
      {%- render 'cart-summary', scope: 'drawer' -%}
      {%- if additional_checkout_buttons and section.settings.show_additional_checkout -%}
        <div class="cart-dyn additional-checkout-buttons" data-cart-dyn>
          {{ content_for_additional_checkout_buttons }}
        </div>
      {%- endif -%}
      <a class="link link--center" href="{{ routes.cart_url }}">{{ 'store.cart.view_cart' | t }}</a>
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "class": "section-cart-drawer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_additional_checkout",
      "default": true,
      "label": "Show accelerated checkout buttons",
      "info": "Buttons such as Shop Pay and Apple Pay appear when set up in your payment settings."
    }
  ]
}
{% endschema %}
