<section class="thanks password">
  <div class="thanks__layer">{%- render 'scene-picture', d: 'sky-d-dusk_sky.webp', m: 'sky-m-dusk_sky.webp', loading: 'eager' -%}</div>
  <div class="thanks__layer">{%- render 'scene-picture', d: 'sky-d-dusk_mid.webp', m: 'sky-m-dusk_mid.webp', loading: 'eager' -%}</div>
  <img class="thanks__petal" src="{{ 'petal-c.webp' | asset_url }}" alt="" width="120" height="120">
  <div class="thanks__card">
    <svg class="footer__mark" viewBox="0 0 40 56" aria-hidden="true"><use href="#emblem" /></svg>
    <h1 class="thanks__title">{{ section.settings.heading | default: shop.name | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="thanks__lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- render 'newsletter-form', id: 'password' -%}
    <details class="password__enter">
      <summary class="link">{{ 'templates.password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="field__err" role="alert">{{ form.errors.messages.form }}</p>{%- endif -%}
        <label class="visually-hidden" for="Password">{{ 'templates.password.label' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'templates.password.label' | t }}" required>
        <button class="pill" type="submit">{{ 'templates.password.submit' | t }}</button>
      {%- endform -%}
    </details>
    <p class="thanks__demo">{{ 'templates.password.owner_html' | t: link: '/admin' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "settings": [
    { "type": "text", "id": "heading", "default": "Opening soon", "label": "t:sections.main-password.settings.heading.label" }
  ]
}
{% endschema %}
