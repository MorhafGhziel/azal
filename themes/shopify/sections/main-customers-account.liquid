{%- comment -%} Account overview: order history and the default address. {%- endcomment -%}
{%- assign greeting_name = customer.first_name | default: customer.name | default: customer.email -%}
<div class="store-section account-section color-{{ section.settings.color_scheme }} full-width">
  <div class="page store-page account-page">
    <header class="page__head acct-head">
      <p class="eyebrow">{{ 'store.customer.account.title' | t }}</p>
      <h1 class="page__title" tabindex="-1">
        <span class="ln"><span class="ln__in">{{ 'store.customer.account.greeting' | t: name: greeting_name | escape }}</span></span>
      </h1>
      <p class="page__lead"><a class="link" href="{{ routes.account_logout_url }}">{{ 'store.customer.account.logout' | t }}</a></p>
    </header>

    <div class="acct">
      <section aria-labelledby="OrderHistory">
        <h2 class="eyebrow acct__h" id="OrderHistory">{{ 'store.customer.orders.title' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="acct__scroll" role="region" aria-labelledby="OrderHistory" tabindex="0">
              <table class="acct__table">
                <caption class="visually-hidden">{{ 'store.customer.orders.title' | t }}</caption>
                <thead>
                  <tr>
                    <th scope="col">{{ 'store.customer.orders.order' | t }}</th>
                    <th scope="col">{{ 'store.customer.orders.date' | t }}</th>
                    <th scope="col">{{ 'store.customer.orders.payment' | t }}</th>
                    <th scope="col">{{ 'store.customer.orders.fulfillment' | t }}</th>
                    <th scope="col" class="acct__num">{{ 'store.customer.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <th scope="row">
                        <a class="link link--quiet" href="{{ order.customer_url }}" aria-label="{{ 'store.customer.orders.view' | t: name: order.name | escape }}">{{ order.name }}</a>
                      </th>
                      <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td class="acct__num">{{ order.total_net_amount | money_with_currency }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <p class="muted">{{ 'store.customer.orders.none' | t }}</p>
            <p><a class="link" href="{{ routes.all_products_collection_url }}">{{ 'store.cart.continue' | t }}</a></p>
          {%- endif -%}
          {%- render 'pagination', paginate: paginate -%}
        {%- endpaginate -%}
      </section>

      <aside aria-labelledby="AccountDetails">
        <h2 class="eyebrow acct__h" id="AccountDetails">{{ 'store.customer.account.details' | t }}</h2>
        <p>{{ customer.name | escape }}<br>{{ customer.email | escape }}</p>
        {%- if customer.default_address -%}
          <address class="acct__address">{{ customer.default_address | format_address }}</address>
        {%- endif -%}
        <p>
          <a class="link" href="{{ routes.account_addresses_url }}">{{ 'store.customer.account.addresses' | t: count: customer.addresses_count }}</a>
        </p>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer account",
  "class": "section-customers-account",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
