{%- comment -%}
  The shop: editorial grid, a text filter row (storefront filters), sort, pagination.
  Filters submit as a normal GET form; azal.js only auto-submits on change.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
  <div class="page shop">
    <header class="page__head">
      <p class="eyebrow">{{ section.settings.eyebrow | default: shop.name | escape }}</p>
      <h1 class="page__title" tabindex="-1"><span class="ln"><span class="ln__in">{{ collection.title | escape }}</span></span></h1>
      {%- if collection.description != blank and section.settings.show_description -%}
        <div class="page__lead rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      <form class="facets" data-facets action="{{ collection.url }}" method="get">
        {%- if section.settings.enable_filtering -%}
          {%- for filter in collection.filters -%}
            {%- case filter.type -%}
              {%- when 'list', 'boolean' -%}
                <fieldset class="filters" aria-label="{{ filter.label | escape }}">
                  <legend class="field__label">{{ filter.label | escape }}</legend>
                  {%- for value in filter.values -%}
                    <label class="filters__b{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                      <input class="visually-hidden" type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} data-autosubmit>
                      <span>{{ value.label | escape }}</span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- when 'price_range' -%}
                <fieldset class="filters filters--price" aria-label="{{ filter.label | escape }}">
                  <legend class="field__label">{{ filter.label | escape }}</legend>
                  <label class="field"><span class="visually-hidden">{{ 'collections.filters.from' | t }}</span>
                    <input type="number" inputmode="decimal" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="0" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}"></label>
                  <span aria-hidden="true">—</span>
                  <label class="field"><span class="visually-hidden">{{ 'collections.filters.to' | t }}</span>
                    <input type="number" inputmode="decimal" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}"></label>
                  <button class="link" type="submit">{{ 'collections.filters.apply' | t }}</button>
                </fieldset>
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.enable_sorting -%}
          <label class="facets__sort">
            <span class="field__label">{{ 'collections.sort.label' | t }}</span>
            {%- assign sort_now = collection.sort_by | default: collection.default_sort_by -%}
            <select name="sort_by" data-autosubmit>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_now %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
        <noscript><button class="link" type="submit">{{ 'collections.filters.apply' | t }}</button></noscript>
      </form>

      {%- liquid
        assign active = 0
        for f in collection.filters
          assign active = active | plus: f.active_values.size
          if f.min_value.value != nil or f.max_value.value != nil
            assign active = active | plus: 1
          endif
        endfor
      -%}
      {%- if active > 0 -%}
        <p class="facets__active">
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}
              <a class="link link--quiet" href="{{ v.url_to_remove }}">{{ v.label | escape }} ✕</a>
            {%- endfor -%}
            {%- if f.min_value.value != nil or f.max_value.value != nil -%}
              <a class="link link--quiet" href="{{ f.url_to_remove }}">{{ f.label | escape }} ✕</a>
            {%- endif -%}
          {%- endfor -%}
          <a class="link" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.filters.clear' | t }}</a>
        </p>
      {%- endif -%}
    {%- endif -%}

    {%- if collection.products.size == 0 -%}
      <p class="shop__empty">{{ 'collections.empty' | t }}</p>
    {%- else -%}
      <ul class="grid" role="list">
        {%- for product in collection.products -%}
          {%- assign wide = false -%}
          {%- if forloop.first and section.settings.first_wide and paginate.current_page == 1 -%}{%- assign wide = true -%}{%- endif -%}
          {%- render 'product-card', product: product, wide: wide, index: forloop.index0, heading_tag: 'h2' -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- render 'pagination', paginate: paginate -%}

    {%- if section.settings.footer_heading != blank or section.settings.footer_text != blank -%}
      <section class="shop__delivery" id="delivery">
        {%- if section.settings.footer_heading != blank -%}<h2 class="eyebrow">{{ section.settings.footer_heading | escape }}</h2>{%- endif -%}
        <div class="rte">{{ section.settings.footer_text }}</div>
      </section>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-collection.name",
  "class": "section-main-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.main-collection.settings.eyebrow.label" },
    { "type": "checkbox", "id": "show_description", "default": true, "label": "t:sections.main-collection.settings.show_description.label" },
    { "type": "range", "id": "per_page", "min": 6, "max": 36, "step": 3, "default": 12, "label": "t:sections.main-collection.settings.per_page.label" },
    { "type": "checkbox", "id": "first_wide", "default": true, "label": "t:sections.main-collection.settings.first_wide.label" },
    { "type": "checkbox", "id": "enable_filtering", "default": true, "label": "t:sections.main-collection.settings.enable_filtering.label", "info": "t:sections.main-collection.settings.enable_filtering.info" },
    { "type": "checkbox", "id": "enable_sorting", "default": true, "label": "t:sections.main-collection.settings.enable_sorting.label" },
    { "type": "text", "id": "footer_heading", "default": "Delivery & returns", "label": "t:sections.main-collection.settings.footer_heading.label" },
    { "type": "richtext", "id": "footer_text", "default": "<p>Standard delivery in 2–4 days. Unopened bottles can be returned within 14 days.</p>", "label": "t:sections.main-collection.settings.footer_text.label" }
  ]
}
{% endschema %}
