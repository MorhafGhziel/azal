<div class="page cart-page" data-cart-page data-section-id="{{ section.id }}">
  <header class="page__head">
    <h1 class="page__title" tabindex="-1"><span class="ln"><span class="ln__in">{{ 'cart.title' | t }}</span></span></h1>
  </header>
  {%- if cart.item_count == 0 -%}
    <div class="bag-empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="link" href="{{ routes.all_products_collection_url }}">{{ 'cart.discover' | t }}</a>
      {%- if shop.customer_accounts_enabled and customer == nil -%}
        <p class="muted small">{{ 'cart.login_html' | t: link: routes.account_login_url }}</p>
      {%- endif -%}
    </div>
  {%- else -%}
    <form class="cart-page__grid" action="{{ routes.cart_url }}" method="post" id="CartForm" novalidate>
      <div class="cart-page__lines" data-cart-body>
        {%- render 'cart-lines' -%}
      </div>
      <aside class="co__sum">
        {%- render 'cart-extras', scope: 'page' -%}
        <dl class="sums">
          {%- for d in cart.cart_level_discount_applications -%}
            <div><dt>{{ d.title | escape }}</dt><dd>-{{ d.total_allocated_amount | money }}</dd></div>
          {%- endfor -%}
          <div class="sums__total"><dt>{{ 'cart.subtotal' | t }}</dt><dd>{{ cart.total_price | money_with_currency }}</dd></div>
        </dl>
        <p class="sums__vat muted">
          {%- if cart.taxes_included -%}{{ 'cart.taxes_included_shipping_at_checkout' | t }}{%- else -%}{{ 'cart.taxes_and_shipping_at_checkout' | t }}{%- endif -%}
        </p>
        <button class="btn btn--solid btn--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        {%- if additional_checkout_buttons and section.settings.show_additional -%}
          <div class="cart-page__dyn">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-cart.name",
  "settings": [
    { "type": "checkbox", "id": "show_additional", "default": true, "label": "t:sections.main-cart.settings.show_additional.label" }
  ]
}
{% endschema %}
