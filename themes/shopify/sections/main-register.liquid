<div class="page page--form">
  <header class="page__head"><h1 class="page__title" tabindex="-1">{{ 'customer.register.title' | t }}</h1></header>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<p class="field__err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="field-row">
      <label class="field"><span class="field__label">{{ 'customer.fields.first_name' | t }}</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="field"><span class="field__label">{{ 'customer.fields.last_name' | t }}</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    </div>
    <label class="field"><span class="field__label">{{ 'customer.fields.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" required></label>
    <label class="field"><span class="field__label">{{ 'customer.fields.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button class="btn btn--solid btn--full" type="submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
  <p class="acct-alt"><a class="link" href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a></p>
</div>

{% schema %}
{ "name": "t:sections.customers.register", "settings": [] }
{% endschema %}
