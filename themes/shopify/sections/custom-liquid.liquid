<div class="custom-liquid color-{{ section.settings.color_scheme }}" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="custom-liquid__in">
    {{ section.settings.custom_liquid }}
  </div>
</div>

{% stylesheet %}
  .custom-liquid { padding-block: var(--pad-top) var(--pad-bottom); }
  .custom-liquid__in { max-width: var(--page-width); margin-inline: auto; padding-inline: var(--gutter); }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "class": "section-custom-liquid",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "Liquid code", "info": "Add app snippets or other Liquid code to create advanced customizations." },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40, "label": "Bottom padding" }
  ],
  "presets": [{ "name": "Custom Liquid" }]
}
{% endschema %}
