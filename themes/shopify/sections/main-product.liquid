{%- comment -%}
  Product: split screen — the bottle floats on its own colour on the left (sticky), details scroll on the right.
  Colour: metafield custom.background_color. Notes: custom.notes_top / notes_heart / notes_base.
  Behaviour: assets/azal-product.js.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign bg = product.metafields.custom.background_color.value | default: settings.color_card_bg
  assign featured = current.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
-%}
<article class="pdp" style="--bg: {{ bg }};" data-product data-section="{{ section.id }}">
  <div class="pdp__visual" data-view>
    <div class="pdp__float" data-float>
      <div class="pdp__bottle" data-main-media>
        {%- if featured -%}
          {{ featured.preview_image | image_url: width: 1800 | image_tag: class: 'pdp__img', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 900px) 50vw, 90vw', alt: featured.alt | default: product.title }}
          <span class="pdp__sweep" aria-hidden="true" style="--mask: url('{{ featured.preview_image | image_url: width: 900 }}');"></span>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pdp__img' }}
        {%- endif -%}
      </div>
    </div>
    {%- if product.media.size > 1 and section.settings.show_thumbs -%}
      <ul class="pdp__thumbs" role="list" aria-label="{{ 'products.product.media' | t }}">
        {%- for media in product.media -%}
          <li>
            <button type="button" class="pdp__thumb{% if media.id == featured.id %} is-on{% endif %}" data-media-id="{{ media.id }}"
              data-src="{{ media.preview_image | image_url: width: 1800 }}"
              data-srcset="{{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1800 }} 1800w"
              aria-label="{{ 'products.product.show_media' | t: index: forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="pdp__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.type | escape }}</p>
        {%- when 'title' -%}
          <h1 class="pdp__name" tabindex="-1" {{ block.shopify_attributes }}><span class="ln"><span class="ln__in">{{ product.title | escape }}</span></span></h1>
        {%- when 'character' -%}
          {%- assign character = product.metafields.custom.character.value -%}
          {%- if character != blank -%}<p class="pdp__meta" {{ block.shopify_attributes }}>{{ character | escape }}</p>{%- endif -%}
        {%- when 'price' -%}
          <p class="pdp__price" data-price aria-live="polite" {{ block.shopify_attributes }}>{% render 'price', variant: current %}</p>
          {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
            <p class="pdp__tax muted">
              {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- endif -%}
              {%- if shop.shipping_policy.body != blank %} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
            </p>
          {%- endif -%}
        {%- when 'variant_picker' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="pdp__options" data-options {{ block.shopify_attributes }}>
              {%- for option in product.options_with_values -%}
                <fieldset class="sizes">
                  <legend class="field__label">{{ option.name | escape }}</legend>
                  {%- for value in option.values -%}
                    <label class="sizes__pill">
                      <input type="radio" name="option{{ option.position }}" form="{{ form_id }}-opts" value="{{ value | escape }}" data-option="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}>
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}
        {%- when 'buy_buttons' -%}
          <div class="pdp__buyblock" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: form_id, class: 'pdp__form', novalidate: 'novalidate', data-product-form: '' -%}
              <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
              <div class="pdp__buy">
                <div class="qty" role="group" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" data-d="-1" aria-label="{{ 'products.product.decrease' | t }}" disabled>−</button>
                  <input class="qty__input" type="number" name="quantity" value="1" min="1" max="99" data-qty aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" data-d="1" aria-label="{{ 'products.product.increase' | t }}">+</button>
                </div>
                <button class="btn btn--solid btn--full" type="submit" name="add" data-buy-main {% unless current.available %}disabled{% endunless %}>
                  {%- if current.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </button>
              </div>
              {%- if block.settings.show_dynamic_checkout -%}
                <div class="pdp__dyn">{{ form | payment_button }}</div>
              {%- endif -%}
              <p class="field__err" data-form-error role="alert"></p>
            {%- endform -%}
            {%- if block.settings.show_pickup -%}
              <div class="pdp__pickup muted">{%- render 'pickup-note', variant: current -%}</div>
            {%- endif -%}
          </div>
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="pdp__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- endif -%}
        {%- when 'notes' -%}
          {%- liquid
            assign top = product.metafields.custom.notes_top.value
            assign heart = product.metafields.custom.notes_heart.value
            assign base = product.metafields.custom.notes_base.value
          -%}
          {%- if top != blank or heart != blank or base != blank -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="eyebrow pdp__h">{{ block.settings.heading | escape }}</h2>
              <ol class="pdp__notes">
                {%- if top != blank -%}<li><span class="notes__n">01</span><span class="notes__name">{{ 'products.notes.top' | t }}</span><span>{{ top | escape }}</span></li>{%- endif -%}
                {%- if heart != blank -%}<li><span class="notes__n">02</span><span class="notes__name">{{ 'products.notes.heart' | t }}</span><span>{{ heart | escape }}</span></li>{%- endif -%}
                {%- if base != blank -%}<li><span class="notes__n">03</span><span class="notes__name">{{ 'products.notes.base' | t }}</span><span>{{ base | escape }}</span></li>{%- endif -%}
              </ol>
            </div>
          {%- endif -%}
        {%- when 'collapsible' -%}
          {%- liquid
            assign body = block.settings.content
            case block.settings.source
              when 'story'
                assign body = product.metafields.custom.story.value | newline_to_br
              when 'wear'
                assign body = product.metafields.custom.how_to_wear.value | newline_to_br
              when 'page'
                assign body = block.settings.page.content
            endcase
          -%}
          {%- if body != blank -%}
            <div class="acc" {{ block.shopify_attributes }}>
              <div class="acc__item">
                <h3><button type="button" class="acc__btn" aria-expanded="false" aria-controls="Acc-{{ block.id }}" id="AccBtn-{{ block.id }}">{{ block.settings.heading | escape }}<span aria-hidden="true">+</span></button></h3>
                <div class="acc__panel rte" id="Acc-{{ block.id }}" role="region" aria-labelledby="AccBtn-{{ block.id }}" hidden>{{ body }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- when 'text' -%}
          <div class="pdp__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</article>

{%- comment -%} variants for the picker, with prices already formatted in the shop's currency {%- endcomment -%}
<script type="application/json" data-variants>
  [
    {%- for v in product.variants -%}
      {"id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available | json }},
       "price": {{ v.price | money | json }}, "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
       "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<div class="buybar" data-buybar aria-hidden="true">
  <span><strong>{{ product.title | escape }}</strong> · <span data-bar-price>{{ current.price | money }}</span></span>
  <button class="btn btn--solid btn--sm" type="button" data-buy-bar tabindex="-1" {% unless current.available %}disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }}</button>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_thumbs", "default": true, "label": "t:sections.main-product.settings.show_thumbs.label" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "eyebrow", "name": "t:sections.main-product.blocks.eyebrow.name", "limit": 1, "settings": [
      { "type": "text", "id": "text", "default": "Eau de Parfum", "label": "t:sections.main-product.blocks.eyebrow.settings.text.label", "info": "t:sections.main-product.blocks.eyebrow.settings.text.info" } ] },
    { "type": "title", "name": "t:sections.main-product.blocks.title.name", "limit": 1, "settings": [] },
    { "type": "character", "name": "t:sections.main-product.blocks.character.name", "limit": 1, "settings": [
      { "type": "paragraph", "content": "t:sections.main-product.blocks.character.settings.paragraph.content" } ] },
    { "type": "price", "name": "t:sections.main-product.blocks.price.name", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "t:sections.main-product.blocks.variant_picker.name", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "t:sections.main-product.blocks.buy_buttons.name", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "default": true, "label": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.label" },
      { "type": "checkbox", "id": "show_pickup", "default": true, "label": "t:sections.main-product.blocks.buy_buttons.settings.show_pickup.label" } ] },
    { "type": "description", "name": "t:sections.main-product.blocks.description.name", "limit": 1, "settings": [] },
    { "type": "notes", "name": "t:sections.main-product.blocks.notes.name", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "default": "Notes", "label": "t:sections.main-product.blocks.notes.settings.heading.label" },
      { "type": "paragraph", "content": "t:sections.main-product.blocks.notes.settings.paragraph.content" } ] },
    { "type": "collapsible", "name": "t:sections.main-product.blocks.collapsible.name", "settings": [
      { "type": "text", "id": "heading", "default": "Delivery & returns", "label": "t:sections.main-product.blocks.collapsible.settings.heading.label" },
      { "type": "select", "id": "source", "default": "text", "label": "t:sections.main-product.blocks.collapsible.settings.source.label", "options": [
        { "value": "text", "label": "t:sections.main-product.blocks.collapsible.settings.source.options__1.label" },
        { "value": "story", "label": "t:sections.main-product.blocks.collapsible.settings.source.options__2.label" },
        { "value": "wear", "label": "t:sections.main-product.blocks.collapsible.settings.source.options__3.label" },
        { "value": "page", "label": "t:sections.main-product.blocks.collapsible.settings.source.options__4.label" }
      ] },
      { "type": "richtext", "id": "content", "default": "<p>Standard delivery in 2–4 days. Unopened bottles can be returned within 14 days.</p>", "label": "t:sections.main-product.blocks.collapsible.settings.content.label" },
      { "type": "page", "id": "page", "label": "t:sections.main-product.blocks.collapsible.settings.page.label" } ] },
    { "type": "text", "name": "t:sections.main-product.blocks.text.name", "settings": [
      { "type": "richtext", "id": "text", "default": "<p>Text</p>", "label": "t:sections.main-product.blocks.text.settings.text.label" } ] }
  ]
}
{% endschema %}
