{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}" class="is-page">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    {%- assign gc_value = gift_card.initial_value | money_without_trailing_zeros -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'azal.css' | asset_url | stylesheet_tag }}
    {{ 'azal-shop.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    {% render 'icon-emblem-symbol' %}
    <main class="page page--center gift">
      <svg class="footer__mark" viewBox="0 0 40 56" aria-hidden="true"><use href="#emblem" /></svg>
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="page__title">{{ 'gift_cards.issued.subtext' | t }}</h1>
      <p class="pdp__price">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="field__err">{{ 'gift_cards.issued.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        <p class="muted">{%- assign gc_exp = gift_card.expires_on | date: '%d/%m/%Y' -%}{{ 'gift_cards.issued.expires_on' | t: expires_on: gc_exp }}</p>
      {%- endif -%}
      <p class="gift__code" aria-label="{{ 'gift_cards.issued.code' | t }}">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p><a class="btn btn--solid" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a></p>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>{%- endif -%}
      <button class="link" type="button" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
