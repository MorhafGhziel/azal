{%- comment -%}
  A full-bleed scene layer: the merchant's own image if chosen, otherwise the theme's painted artwork
  (with its own portrait crop for phones).
  Accepts: image (image_picker value, optional), d (desktop asset name), m (mobile asset name, optional),
  alt, loading ('lazy' | 'eager'), priority (bool)
{%- endcomment -%}
{%- liquid
  assign l = loading | default: 'lazy'
  assign fp = 'auto'
  if priority
    assign fp = 'high'
  endif
-%}
<picture>
  {%- if image != blank -%}
    {{ image | image_url: width: 2560 | image_tag: loading: l, fetchpriority: fp, widths: '750, 1100, 1500, 2000, 2560', sizes: '100vw', alt: alt | default: '' }}
  {%- else -%}
    {%- if m != blank -%}<source media="(max-aspect-ratio: 1/1)" srcset="{{ m | asset_url }}">{%- endif -%}
    <img src="{{ d | asset_url }}" alt="{{ alt | escape }}" decoding="async" loading="{{ l }}" fetchpriority="{{ fp }}" width="2560" height="1440">
  {%- endif -%}
</picture>
