{%- comment -%}
  With two languages: one button that switches to the other (the site's "ع / EN" toggle).
  With more: one button per language.
  Accepts: class, long (show the full language name)
{%- endcomment -%}
{%- form 'localization', class: 'lang-form' -%}
  <input type="hidden" name="locale_code" value="">
  {%- for language in localization.available_languages -%}
    {%- unless language.iso_code == localization.language.iso_code -%}
      {%- liquid
        assign short = language.iso_code | upcase
        if language.iso_code == 'ar'
          assign short = 'ع'
        endif
      -%}
      <button class="{{ class }}" type="submit" name="locale_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}" aria-label="{{ language.endonym_name | escape }}">
        {%- if long -%}{{ language.endonym_name }}{%- else -%}{{ short }}{%- endif -%}
      </button>
    {%- endunless -%}
  {%- endfor -%}
{%- endform -%}
