{%- doc -%}
  Social profile links with inline icons, read from the global social settings (Theme settings > Social media).
  Renders nothing when no profile is set.

  @param {string} [class] - Extra class on the list
  @param {string} [attrs] - Extra attributes on the list (for example block.shopify_attributes)
{%- enddoc -%}
{%- liquid
  assign networks = 'instagram,tiktok,facebook,x,pinterest,snapchat,youtube,whatsapp' | split: ','
  assign has_any = false
  for net in networks
    assign key = 'social_' | append: net | append: '_link'
    if settings[key] != blank
      assign has_any = true
    endif
  endfor
-%}
{%- if has_any -%}
  <ul class="social-icons {{ class }}" role="list" {{ attrs }}>
    {%- for net in networks -%}
      {%- assign key = 'social_' | append: net | append: '_link' -%}
      {%- if settings[key] != blank -%}
        {%- assign label_key = 'footer.social.' | append: net -%}
        <li>
          <a class="social-icons__link" href="{{ settings[key] | escape }}" target="_blank" rel="noopener">
            <span class="visually-hidden">{{ label_key | t }} {{ 'footer.social.new_window' | t }}</span>
            {%- case net -%}
              {%- when 'instagram' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.6" cy="6.4" r="1.2" fill="currentColor"/></svg>
