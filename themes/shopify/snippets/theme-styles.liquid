{%- comment -%}
  Fonts and colour tokens from theme settings. The house fonts ship with the theme (SIL Open Font License);
  "Custom" switches to fonts chosen in the editor from the Shopify font library.
{%- endcomment -%}
<style>
  {%- if settings.type_mode == 'house' -%}
    @font-face { font-family: 'Cormorant Variable'; font-style: normal; font-weight: 300 700; font-display: swap; src: url({{ 'cormorant-latin-wght-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Cormorant Variable'; font-style: normal; font-weight: 300 700; font-display: swap; src: url({{ 'cormorant-latin-ext-wght-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    @font-face { font-family: 'Cormorant Variable'; font-style: italic; font-weight: 300 700; font-display: swap; src: url({{ 'cormorant-latin-wght-italic.woff2' | asset_url }}) format('woff2'); }
    @font-face { font-family: 'Hanken Grotesk Variable'; font-style: normal; font-weight: 100 900; font-display: swap; src: url({{ 'hanken-grotesk-latin-wght-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Hanken Grotesk Variable'; font-style: normal; font-weight: 100 900; font-display: swap; src: url({{ 'hanken-grotesk-latin-ext-wght-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  {%- else -%}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {%- endif -%}
  @font-face { font-family: 'Amiri'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'amiri-arabic-400-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC, U+102E0-102FB, U+10E60-10E7E, U+10EC2-10EC4, U+10EFC-10EFF, U+1EE00-1EEFF; }
  @font-face { font-family: 'Amiri'; font-style: normal; font-weight: 700; font-display: swap; src: url({{ 'amiri-arabic-700-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }
  @font-face { font-family: 'Amiri'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'amiri-latin-400-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+2000-206F; }
  {%- assign weights = '300,400,500' | split: ',' -%}
  {%- for w in weights -%}
    @font-face { font-family: 'IBM Plex Sans Arabic'; font-style: normal; font-weight: {{ w }}; font-display: swap; src: url({{ 'ibm-plex-sans-arabic-arabic-' | append: w | append: '-normal.woff2' | asset_url }}) format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }
  {%- endfor -%}

  :root {
    --ivory: {{ settings.color_ivory }};
    --ink: {{ settings.color_ink }};
    --cream: {{ settings.color_cream }};
    --blush: {{ settings.color_blush }};
    --apricot: {{ settings.color_apricot }};
    --wine: {{ settings.color_wine }};
    --wine-deep: {{ settings.color_wine_deep }};
    --success: {{ settings.color_success }};
    --error: {{ settings.color_error }};
    --card-bg: {{ settings.color_card_bg }};
    --img-grain: url({{ 'grain.png' | asset_url }});
    --img-petal-sheet: url({{ 'petal-sheet.webp' | asset_url }});
    --radius-btn: {{ settings.button_radius }}px;
    --page-width: {{ settings.page_width }}px;
    {%- if settings.type_mode == 'house' %}
      --serif: 'Cormorant Variable', Georgia, serif;
      --sans: 'Hanken Grotesk Variable', system-ui, sans-serif;
    {%- else %}
      --serif: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --sans: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    {%- endif %}
    --serif-ar: 'Amiri', var(--serif);
    --sans-ar: 'IBM Plex Sans Arabic', var(--sans);
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
  }
</style>
