{%- doc -%}
  Cart line items, shared by the cart page and the cart drawer. Quantity changes go through
  assets/azal-cart.js (Section Rendering API) and fall back to the cart form's `updates[]` without JavaScript.

  @param {string} scope - 'page' or 'drawer' (keeps ids unique when both are on the page)
{%- enddoc -%}
{%- liquid
  assign scope = scope | default: 'page'
  assign form_id = 'CartForm'
  if scope == 'drawer'
    assign form_id = 'CartDrawerForm'
  endif
  assign img_width = 240
  if scope == 'page'
    assign img_width = 360
  endif
-%}
{%- if cart.item_count == 0 -%}
  <div class="bag-empty cart-empty">
    <p class="cart-empty__title">{{ 'store.cart.empty' | t }}</p>
    <a class="btn btn--line" href="{{ routes.all_products_collection_url }}">{{ 'store.cart.continue' | t }}</a>
    {%- if shop.customer_accounts_enabled and customer == nil -%}
      <p class="cart-empty__login small muted">
        {{ 'store.cart.login_html' | t: link: routes.account_login_url }}
      </p>
    {%- endif -%}
  </div>
{%- else -%}
  <ul class="bag-lines cart-lines" role="list" aria-label="{{ 'store.cart.items_label' | t }}">
    {%- for item in cart.items -%}
      {%- liquid
        assign line = forloop.index
        assign qty_id = 'Quantity-' | append: scope | append: '-' | append: line
        assign rule = item.variant.quantity_rule
        assign step = rule.increment | default: 1
        assign min = rule.min | default: 1
        assign dec_to = item.quantity | minus: step
        if dec_to < min
          assign dec_to = 0
        endif
        assign inc_to = item.quantity | plus: step
      -%}
      <li class="bag-line cart-line" id="CartLine-{{ scope }}-{{ line }}" data-line="{{ line }}" data-key="{{ item.key }}">
        <a class="bag-line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
          {%- if item.image -%}
            {{
              item.image
              | image_url: width: img_width
              | image_tag: loading: 'lazy', widths: '120, 180, 240, 360', sizes: '(min-width: 900px) 120px, 90px', alt: item.image.alt
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'card__ph' }}
          {%- endif -%}
        </a>

        <div class="bag-line__info">
          {%- if item.vendor != blank and settings.card_show_vendor -%}
            <p class="cart-line__vendor eyebrow">{{ item.vendor | escape }}</p>
          {%- endif -%}
          <p class="bag-line__name"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></p>

          {%- if item.original_price != item.final_price -%}
            <p class="bag-line__meta cart-line__each">
              <span class="visually-hidden">{{ 'store.cart.regular_price' | t }}</span>
              <s>{{ item.original_price | money }}</s>
              <span class="visually-hidden">{{ 'store.cart.sale_price' | t }}</span>
              <span>{{ item.final_price | money }}</span>
            </p>
          {%- else -%}
            <p class="bag-line__meta cart-line__each">{{ item.final_price | money }}</p>
          {%- endif -%}

          {%- if item.product.has_only_default_variant == false or item.properties.size > 0 or item.selling_plan_allocation -%}
            <dl class="cart-line__opts">
              {%- unless item.product.has_only_default_variant -%}
                {%- for option in item.options_with_values -%}
                  <div><dt>{{ option.name | escape }}:</dt> <dd>{{ option.value | escape }}</dd></div>
                {%- endfor -%}
              {%- endunless -%}
              {%- for property in item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and first_char != '_' -%}
                  <div>
                    <dt>{{ property.first | escape }}:</dt>
                    <dd>
                      {%- if property.last contains '/uploads/' -%}
                        <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                      {%- else -%}
                        {{ property.last | escape }}
                      {%- endif -%}
                    </dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </dl>
            {%- if item.selling_plan_allocation -%}
              <p class="bag-line__meta cart-line__plan">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
            {%- endif -%}
          {%- endif -%}

          {%- if item.unit_price_measurement -%}
            <p class="bag-line__meta cart-line__unit">
              <span class="visually-hidden">{{ 'store.cart.unit_price' | t }}</span>
              {{ item.unit_price | money }}<span aria-hidden="true">/</span><span class="visually-hidden">&nbsp;{{ 'store.cart.per' | t }}&nbsp;</span>
              {%- if item.unit_price_measurement.reference_value != 1 -%}{{ item.unit_price_measurement.reference_value }}{%- endif -%}
              {{ item.unit_price_measurement.reference_unit }}
            </p>
          {%- endif -%}

          {%- if item.line_level_discount_allocations.size > 0 -%}
            <ul class="cart-line__discounts" role="list" aria-label="{{ 'store.cart.discounts' | t }}">
              {%- for allocation in item.line_level_discount_allocations -%}
                <li>
                  {%- render 'cart-icon', icon: 'tag' -%}
                  <span>{{ allocation.discount_application.title | escape }} (-{{ allocation.amount | money }})</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="cart-line__controls">
            <div class="qty qty--sm cart-qty">
              <label class="visually-hidden" for="{{ qty_id }}">{{ 'store.cart.quantity_for' | t: title: item.product.title }}</label>
              <button
                type="button"
                class="cart-qty__btn"
                data-qty-line="{{ line }}"
                data-to="{{ dec_to }}"
                data-dir="-1"
                aria-label="{{ 'store.cart.decrease' | t: title: item.product.title }}"
                aria-controls="{{ qty_id }}"
              >
                <span aria-hidden="true">&minus;</span>
              </button>
              <input
                class="qty__input cart-qty__input"
                type="number"
                id="{{ qty_id }}"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                step="{{ step }}"
                {% if rule.max != null %}
                  max="{{ rule.max }}"
                {% endif %}
                inputmode="numeric"
                data-qty-input="{{ line }}"
                data-qty-prev="{{ item.quantity }}"
                data-min="{{ min }}"
                form="{{ form_id }}"
              >
              <button
                type="button"
                class="cart-qty__btn"
                data-qty-line="{{ line }}"
                data-to="{{ inc_to }}"
                data-dir="1"
                aria-label="{{ 'store.cart.increase' | t: title: item.product.title }}"
                aria-controls="{{ qty_id }}"
                {% if rule.max != null and item.quantity >= rule.max %}
                  disabled
                {% endif %}
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>
            <a
              class="link link--quiet cart-line__remove"
              href="{{ item.url_to_remove }}"
              data-qty-line="{{ line }}"
              data-to="0"
              aria-label="{{ 'store.cart.remove_title' | t: title: item.product.title }}"
            >
              {{- 'store.cart.remove' | t -}}
            </a>
          </div>
          <p class="field__err cart-line__error" id="CartLineError-{{ scope }}-{{ line }}" data-line-error="{{ line }}" role="alert"></p>
        </div>

        <div class="bag-line__end">
          <p class="bag-line__price cart-line__total">
            {%- if item.original_line_price != item.final_line_price -%}
              <span class="visually-hidden">{{ 'store.cart.regular_price' | t }}</span>
              <s class="muted">{{ item.original_line_price | money }}</s>
              <span class="visually-hidden">{{ 'store.cart.sale_price' | t }}</span>
            {%- endif -%}
            <span>{{ item.final_line_price | money }}</span>
          </p>
        </div>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
