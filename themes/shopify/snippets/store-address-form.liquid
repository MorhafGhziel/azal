{%- doc -%}
  Address fields for the customer address forms. Country and province are dropdowns: the provinces of the
  chosen country come from `all_country_option_tags` (each option carries `data-provinces`) and are filled in
  by assets/azal-store.js.

  @param {object} form - The customer_address form object
  @param {string} id - 'new' or the address id (keeps ids unique)
  @param {boolean} [is_default] - Whether this address is the default one
{%- enddoc -%}
{%- assign errors_id = 'AddressErrors_' | append: id -%}
{%- render 'store-form-errors', form: form, id: errors_id -%}
<div class="field-row">
  <div class="field">
    <label class="field__label" for="AddressFirstName_{{ id }}">{{ 'store.customer.fields.first_name' | t }}</label>
    <input type="text" id="AddressFirstName_{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="field">
    <label class="field__label" for="AddressLastName_{{ id }}">{{ 'store.customer.fields.last_name' | t }}</label>
    <input type="text" id="AddressLastName_{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>
<div class="field">
  <label class="field__label" for="AddressCompany_{{ id }}">{{ 'store.customer.fields.company' | t }}</label>
  <input type="text" id="AddressCompany_{{ id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="field">
  <label class="field__label" for="AddressAddress1_{{ id }}">{{ 'store.customer.fields.address1' | t }}</label>
  <input type="text" id="AddressAddress1_{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label class="field__label" for="AddressAddress2_{{ id }}">{{ 'store.customer.fields.address2' | t }}</label>
  <input type="text" id="AddressAddress2_{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="field-row">
  <div class="field">
    <label class="field__label" for="AddressCity_{{ id }}">{{ 'store.customer.fields.city' | t }}</label>
    <input type="text" id="AddressCity_{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="field">
    <label class="field__label" for="AddressZip_{{ id }}">{{ 'store.customer.fields.zip' | t }}</label>
    <input type="text" id="AddressZip_{{ id }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code">
  </div>
</div>
<div class="field-row" data-address-country-row>
  <div class="field">
    <label class="field__label" for="AddressCountry_{{ id }}">{{ 'store.customer.fields.country' | t }}</label>
    <select
      id="AddressCountry_{{ id }}"
      name="address[country]"
      autocomplete="country-name"
      data-address-country
      data-province-target="AddressProvince_{{ id }}"
      data-default="{{ form.country | escape }}"
    >
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="field" id="AddressProvinceContainer_{{ id }}" data-address-province-wrap>
    <label class="field__label" for="AddressProvince_{{ id }}">{{ 'store.customer.fields.province' | t }}</label>
    <select
      id="AddressProvince_{{ id }}"
      name="address[province]"
      autocomplete="address-level1"
      data-default="{{ form.province | escape }}"
    ></select>
  </div>
</div>
<div class="field">
  <label class="field__label" for="AddressPhone_{{ id }}">{{ 'store.customer.fields.phone' | t }}</label>
  <input type="tel" id="AddressPhone_{{ id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<div class="check">
  <input type="checkbox" id="AddressDefault_{{ id }}" name="address[default]" value="1"{% if is_default %} checked{% endif %}>
  <label for="AddressDefault_{{ id }}">{{ 'store.customer.addresses.set_default' | t }}</label>
</div>
