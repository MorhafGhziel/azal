{%- doc -%}
  The product's media: a swipeable stage (images float on the product's own colour; videos, YouTube/Vimeo and
  3D models load on demand) and a thumbnail row. The selected variant's media is shown first.
  Behaviour lives in assets/azal-product.js ([data-gallery]).

  @param {product} product - The product.
  @param {string} section_id - The section id, used for unique ids.
  @param {variant} [variant] - The selected variant; its featured media opens first.
  @param {boolean} [eager] - Load the first image eagerly with high priority (main product above the fold).
  @param {string} [sizes] - The sizes attribute for stage images.
  @param {boolean} [show_thumbs] - Show the thumbnail row. Default true.

  @example
  {% render 'product-gallery', product: product, section_id: section.id, variant: current, eager: true %}
{%- enddoc -%}
{%- liquid
  assign first_media = variant.featured_media | default: product.featured_media
  assign media_count = product.media.size
  assign stage_sizes = sizes | default: '(min-width: 990px) 55vw, 100vw'
  assign gallery_label = 'products.media.gallery' | t
-%}
<div class="pdp-media{% if media_count < 2 %} pdp-media--single{% endif %}" data-gallery>
  <div class="pdp-media__stage">
    {%- if media_count == 0 -%}
      <div class="pdp-media__item pdp-media__item--placeholder">
        <div class="pdp-media__float">{{ 'product-1' | placeholder_svg_tag: 'pdp-media__placeholder' }}</div>
      </div>
    {%- else -%}
      <ul class="pdp-media__track" role="list" aria-label="{{ gallery_label }}" tabindex="0" data-track>
        {%- liquid
          assign ordered = product.media
          if first_media and product.media.first.id != first_media.id
            assign rest = product.media | where: 'id', first_media.id
            assign ordered = rest | concat: product.media
          endif
          assign rendered_ids = ','
          assign position = 0
        -%}
        {%- for media in ordered -%}
          {%- liquid
            assign media_key = ',' | append: media.id | append: ','
            if rendered_ids contains media_key
              continue
            endif
            assign rendered_ids = rendered_ids | append: media.id | append: ','
            assign position = position | plus: 1
            assign ratio = media.preview_image.aspect_ratio | default: 1
            assign media_alt = media.alt | default: product.title
            assign loading = 'lazy'
            assign priority = 'auto'
            if position == 1 and eager
              assign loading = 'eager'
              assign priority = 'high'
            endif
          -%}
          <li
            class="pdp-media__item pdp-media__item--{{ media.media_type }}{% if position == 1 %} is-active{% endif %}"
            id="Media-{{ section_id }}-{{ media.id }}"
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            style="--ratio: {{ ratio }};"
            aria-label="{{ 'products.media.position' | t: index: position, count: media_count }}"
            aria-roledescription="{{ 'products.media.slide' | t }}"
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <div class="pdp-media__float">
                  <div class="pdp-media__box">
                    {{
                      media.preview_image
                      | image_url: width: 2000
                      | image_tag:
                        class: 'pdp-media__img',
                        loading: loading,
                        fetchpriority: priority,
                        widths: '480, 720, 960, 1200, 1500, 1800, 2000',
                        sizes: stage_sizes,
                        alt: media_alt
                    }}
                  </div>
                </div>
              {%- else -%}
                {%- liquid
                  if media.media_type == 'model'
                    assign play_label = 'products.media.load_model' | t: title: media_alt
                  else
                    assign play_label = 'products.media.play_video' | t: title: media_alt
                  endif
                -%}
                <div class="pdp-media__box pdp-media__box--deferred" data-deferred>
                  <button type="button" class="pdp-media__poster" data-deferred-load aria-label="{{ play_label | escape }}">
                    {%- if media.preview_image -%}
                      {{
                        media.preview_image
                        | image_url: width: 1500
                        | image_tag:
                          loading: loading,
                          widths: '480, 720, 960, 1200, 1500',
                          sizes: stage_sizes,
                          alt: ''
                      }}
                    {%- endif -%}
                    <span class="pdp-media__play">
                      {%- if media.media_type == 'model' -%}
                        {%- render 'product-icon', icon: 'cube' -%}
                      {%- else -%}
                        {%- render 'product-icon', icon: 'play' -%}
                      {%- endif -%}
                    </span>
                  </button>
                  <template>
                    {%- case media.media_type -%}
                      {%- when 'external_video' -%}
                        {%- assign video_title = media.alt | default: product.title -%}
                        {{ media | external_video_url: autoplay: true, playsinline: 1 | external_video_tag: loading: 'lazy', title: video_title }}
                      {%- when 'video' -%}
                        {{ media | video_tag: image_size: '1500x', autoplay: true, controls: true, playsinline: true, preload: 'metadata' }}
                      {%- when 'model' -%}
                        {{ media | model_viewer_tag: image_size: '1500x', reveal: 'interaction', toggleable: true, interaction-prompt-threshold: 0, data-model-id: media.id }}
                    {%- endcase -%}
                  </template>
                </div>
                {%- if media.media_type == 'model' -%}
                  <button
                    type="button"
                    class="pdp-media__xr pill"
                    data-shopify-xr
                    data-shopify-model3d-id="{{ media.id }}"
                    data-shopify-title="{{ product.title | escape }}"
                    data-shopify-xr-hidden
                  >
                    {%- render 'product-icon', icon: 'cube' -%}
                    {{ 'products.media.view_in_space' | t }}
                  </button>
                {%- endif -%}
            {%- endcase -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if media_count > 1 -%}
        <div class="pdp-media__nav">
          <button type="button" class="pdp-media__arrow" data-gallery-step="-1" aria-label="{{ 'products.media.previous' | t }}">
            {%- render 'product-icon', icon: 'prev' -%}
          </button>
          <span class="pdp-media__count" aria-hidden="true"><span data-gallery-index>1</span> / {{ media_count }}</span>
          <button type="button" class="pdp-media__arrow" data-gallery-step="1" aria-label="{{ 'products.media.next' | t }}">
            {%- render 'product-icon', icon: 'next' -%}
          </button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if media_count > 1 and show_thumbs != false -%}
    {%- assign thumbs_seen = ',' -%}
    {%- assign thumb_index = 0 -%}
    <ul class="pdp-media__thumbs" role="list" aria-label="{{ 'products.media.thumbnails' | t }}">
      {%- for media in ordered -%}
        {%- liquid
          assign thumb_key = ',' | append: media.id | append: ','
          if thumbs_seen contains thumb_key
            continue
          endif
          assign thumbs_seen = thumbs_seen | append: media.id | append: ','
          assign thumb_index = thumb_index | plus: 1
        -%}
        <li>
          <button
            type="button"
            class="pdp-media__thumb"
            data-thumb="{{ media.id }}"
            aria-controls="Media-{{ section_id }}-{{ media.id }}"
            {% if thumb_index == 1 %}
              aria-current="true"
            {% endif %}
            aria-label="{{ 'products.media.show' | t: index: thumb_index }}"
          >
            {%- if media.preview_image -%}
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '64px', alt: '' }}
            {%- endif -%}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <span class="pdp-media__thumb-badge">{%- render 'product-icon', icon: 'play' -%}</span>
            {%- elsif media.media_type == 'model' -%}
              <span class="pdp-media__thumb-badge">{%- render 'product-icon', icon: 'cube' -%}</span>
            {%- endif -%}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- assign models = product.media | where: 'media_type', 'model' -%}
  {%- if models.size > 0 -%}
    <script type="application/json" data-product-models>
      {{ models | json }}
    </script>
  {%- endif -%}
</div>
