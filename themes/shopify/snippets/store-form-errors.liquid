{%- doc -%}
  Announces a form's errors: a focusable heading (screen readers hear it at once) and Shopify's error list.

  @param {object} form - The form object inside a {% form %} tag
  @param {string} id - A unique id for the message
{%- enddoc -%}
{%- if form.errors -%}
  <div class="store-errors" id="{{ id }}" role="alert">
    <h2 class="store-errors__title" tabindex="-1" autofocus>
      {%- render 'cart-icon', icon: 'close' -%}
      <span>{{ 'store.forms.error_heading' | t }}</span>
    </h2>
    {{ form.errors | default_errors }}
  </div>
{%- endif -%}
