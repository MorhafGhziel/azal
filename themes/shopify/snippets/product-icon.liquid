{%- doc -%}
  Small inline icons used by the product workstream. Decorative (aria-hidden); the caller supplies text.

  @param {string} icon - One of: play, cube, prev, next, share, close, check, pin, plus.

  @example
  {% render 'product-icon', icon: 'play' %}
{%- enddoc -%}
{%- case icon -%}
  {%- when 'play' -%}
    <svg class="icon icon--play" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
  {%- when 'cube' -%}
    <svg class="icon icon--cube" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M12 2.8 20 7.3v9.4l-8 4.5-8-4.5V7.3zm0 0v9m0 0 8-4.5M12 11.8 4 7.3m8 4.5v9.4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
  {%- when 'prev' -%}
    <svg class="icon icon--dir" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'next' -%}
    <svg class="icon icon--dir" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M9.5 5.5 16 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'share' -%}
    <svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v8h14v-8" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'close' -%}
    <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'check' -%}
    <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'pin' -%}
    <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21zm0-8.7a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'plus' -%}
    <svg class="icon icon--plus" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
{%- endcase -%}
