{%- liquid
  assign rtl_langs = 'ar,he,fa,ur' | split: ','
  assign dir = 'ltr'
  if rtl_langs contains request.locale.iso_code
    assign dir = 'rtl'
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ dir }}" class="is-page template-password">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_ivory }}">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{%- endif -%}
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    {{ 'azal.css' | asset_url | stylesheet_tag }}
    {{ 'azal-shop.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    {% render 'icon-emblem-symbol' %}
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
