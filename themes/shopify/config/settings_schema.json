[
  {
    "name": "theme_info",
    "theme_name": "AZAL",
    "theme_version": "1.0.0",
    "theme_author": "SIMA",
    "theme_documentation_url": "https://www.simastudio.it.com",
    "theme_support_url": "https://www.simastudio.it.com"
  },
  {
    "name": "t:settings_schema.logo.name",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "t:settings_schema.logo.settings.logo.label", "info": "t:settings_schema.logo.settings.logo.info" },
      { "type": "range", "id": "logo_width", "min": 16, "max": 160, "step": 2, "unit": "px", "default": 26, "label": "t:settings_schema.logo.settings.logo_width.label" },
      { "type": "image_picker", "id": "favicon", "label": "t:settings_schema.logo.settings.favicon.label" }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      { "type": "header", "content": "t:settings_schema.colors.settings.header_light.content" },
      { "type": "color", "id": "color_ivory", "default": "#f4efe7", "label": "t:settings_schema.colors.settings.color_ivory.label" },
      { "type": "color", "id": "color_ink", "default": "#1a1614", "label": "t:settings_schema.colors.settings.color_ink.label" },
      { "type": "color", "id": "color_card_bg", "default": "#ece4da", "label": "t:settings_schema.colors.settings.color_card_bg.label", "info": "t:settings_schema.colors.settings.color_card_bg.info" },
      { "type": "header", "content": "t:settings_schema.colors.settings.header_dark.content" },
      { "type": "color", "id": "color_wine", "default": "#4a1419", "label": "t:settings_schema.colors.settings.color_wine.label" },
      { "type": "color", "id": "color_wine_deep", "default": "#2b0a0e", "label": "t:settings_schema.colors.settings.color_wine_deep.label" },
      { "type": "color", "id": "color_cream", "default": "#fbf3e6", "label": "t:settings_schema.colors.settings.color_cream.label" },
      { "type": "header", "content": "t:settings_schema.colors.settings.header_accents.content" },
      { "type": "color", "id": "color_blush", "default": "#e9c6b8", "label": "t:settings_schema.colors.settings.color_blush.label" },
      { "type": "color", "id": "color_apricot", "default": "#d9a25f", "label": "t:settings_schema.colors.settings.color_apricot.label" },
      { "type": "color", "id": "color_success", "default": "#3d4a37", "label": "t:settings_schema.colors.settings.color_success.label" },
      { "type": "color", "id": "color_error", "default": "#9b2f2a", "label": "t:settings_schema.colors.settings.color_error.label" }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "select", "id": "type_mode", "default": "house", "label": "t:settings_schema.typography.settings.type_mode.label",
        "info": "t:settings_schema.typography.settings.type_mode.info",
        "options": [
          { "value": "house", "label": "t:settings_schema.typography.settings.type_mode.options__1.label" },
          { "value": "custom", "label": "t:settings_schema.typography.settings.type_mode.options__2.label" }
        ]
      },
      { "type": "font_picker", "id": "type_header_font", "default": "assistant_n4", "label": "t:settings_schema.typography.settings.type_header_font.label" },
      { "type": "font_picker", "id": "type_body_font", "default": "assistant_n4", "label": "t:settings_schema.typography.settings.type_body_font.label" },
      { "type": "range", "id": "heading_scale", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100, "label": "t:settings_schema.typography.settings.heading_scale.label" }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1800, "step": 50, "unit": "px", "default": 1600, "label": "t:settings_schema.layout.settings.page_width.label" },
      { "type": "range", "id": "button_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40, "label": "t:settings_schema.layout.settings.button_radius.label" }
    ]
  },
  {
    "name": "t:settings_schema.motion.name",
    "settings": [
      { "type": "paragraph", "content": "t:settings_schema.motion.settings.paragraph.content" },
      { "type": "checkbox", "id": "enable_loader", "default": true, "label": "t:settings_schema.motion.settings.enable_loader.label" },
      { "type": "checkbox", "id": "enable_smooth_scroll", "default": true, "label": "t:settings_schema.motion.settings.enable_smooth_scroll.label" },
      { "type": "checkbox", "id": "enable_page_transitions", "default": true, "label": "t:settings_schema.motion.settings.enable_page_transitions.label" },
      { "type": "checkbox", "id": "enable_cursor", "default": true, "label": "t:settings_schema.motion.settings.enable_cursor.label" },
      { "type": "checkbox", "id": "enable_petals", "default": true, "label": "t:settings_schema.motion.settings.enable_petals.label" },
      { "type": "checkbox", "id": "enable_grain", "default": true, "label": "t:settings_schema.motion.settings.enable_grain.label" }
    ]
  },
  {
    "name": "t:settings_schema.products.name",
    "settings": [
      { "type": "paragraph", "content": "t:settings_schema.products.settings.paragraph.content" },
      { "type": "checkbox", "id": "card_show_character", "default": true, "label": "t:settings_schema.products.settings.card_show_character.label" },
      { "type": "checkbox", "id": "card_quick_add", "default": true, "label": "t:settings_schema.products.settings.card_quick_add.label" },
      { "type": "checkbox", "id": "card_show_vendor", "default": false, "label": "t:settings_schema.products.settings.card_show_vendor.label" },
      {
        "type": "select", "id": "card_image_fit", "default": "contain", "label": "t:settings_schema.products.settings.card_image_fit.label",
        "options": [
          { "value": "contain", "label": "t:settings_schema.products.settings.card_image_fit.options__1.label" },
          { "value": "cover", "label": "t:settings_schema.products.settings.card_image_fit.options__2.label" }
        ]
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "select", "id": "cart_type", "default": "drawer", "label": "t:settings_schema.cart.settings.cart_type.label",
        "options": [
          { "value": "drawer", "label": "t:settings_schema.cart.settings.cart_type.options__1.label" },
          { "value": "page", "label": "t:settings_schema.cart.settings.cart_type.options__2.label" }
        ]
      },
      { "type": "checkbox", "id": "cart_gift_wrap", "default": true, "label": "t:settings_schema.cart.settings.cart_gift_wrap.label", "info": "t:settings_schema.cart.settings.cart_gift_wrap.info" },
      { "type": "checkbox", "id": "cart_note", "default": true, "label": "t:settings_schema.cart.settings.cart_note.label" },
      { "type": "text", "id": "cart_shipping_note", "label": "t:settings_schema.cart.settings.cart_shipping_note.label" }
    ]
  },
  {
    "name": "t:settings_schema.social.name",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "t:settings_schema.social.settings.social_instagram_link.label", "placeholder": "https://instagram.com/shopify" },
      { "type": "text", "id": "social_tiktok_link", "label": "t:settings_schema.social.settings.social_tiktok_link.label", "placeholder": "https://tiktok.com/@shopify" },
      { "type": "text", "id": "social_snapchat_link", "label": "t:settings_schema.social.settings.social_snapchat_link.label", "placeholder": "https://snapchat.com/add/shopify" },
      { "type": "text", "id": "social_twitter_link", "label": "t:settings_schema.social.settings.social_twitter_link.label", "placeholder": "https://x.com/shopify" },
      { "type": "text", "id": "social_facebook_link", "label": "t:settings_schema.social.settings.social_facebook_link.label", "placeholder": "https://facebook.com/shopify" },
      { "type": "text", "id": "social_pinterest_link", "label": "t:settings_schema.social.settings.social_pinterest_link.label", "placeholder": "https://pinterest.com/shopify" },
      { "type": "text", "id": "social_youtube_link", "label": "t:settings_schema.social.settings.social_youtube_link.label", "placeholder": "https://youtube.com/shopify" },
      { "type": "text", "id": "social_whatsapp", "label": "t:settings_schema.social.settings.social_whatsapp.label", "placeholder": "https://wa.me/9665XXXXXXXX" }
    ]
  }
]
